# npm start does not load .env automatically. Export variables or use Node --env-file.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# In production set your exact HTTPS origin, with no trailing slash:
# PUBLIC_ORIGIN=https://your-domain.example
# NODE_ENV=production
# Neon pooled connection string. Set as a Render secret, without surrounding quotes.
# DATABASE_URL=postgresql://user:password@your-endpoint-pooler.example/neondb?sslmode=require
# If DATABASE_URL is set, PostgreSQL is required; a connection failure never falls back to SQLite.
# Admin inbox: choose a unique password (16–256 characters); never put it in browser code.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-long-unique-password-in-your-host-secrets
# Configure these in a private .env or your host's secrets, never in browser code.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=your-authorized-smtp-user
# SMTP_PASS=your-app-password-or-smtp-password
# SMTP_FROM=your-verified-sender@example.com
# Recipient is fixed to connectwithsahara@study.iitm.ac.in.
